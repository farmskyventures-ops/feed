# =====================================================================
# Farmsky — environment configuration (Node server)
# Copy to .env and fill in. The Node server reads these on boot.
# =====================================================================

# ----- PostgreSQL database -----
# Option A: a single connection string (recommended for managed Postgres,
#           e.g. AWS RDS, Supabase, Neon). Append ?sslmode=require for SSL.
# DATABASE_URL=postgresql://farmsky:farmsky@127.0.0.1:5432/farmsky
# DATABASE_URL=postgresql://user:pass@your-host.rds.amazonaws.com:5432/farmsky?sslmode=require

# Option B: discrete variables (used only when DATABASE_URL is unset)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=farmsky
PGPASSWORD=farmsky
PGDATABASE=farmsky
# PGPOOL_MAX=10

# ----- HTTP server -----
PORT=8080

# =====================================================================
# CENTRAL PAYMENT GATEWAY (REQUIRED for live payments)
# ---------------------------------------------------------------------
# FEED is a SATELLITE app. It does NOT hold any M-Pesa / SasaPay / Buni
# provider credentials. Instead it forwards every payment as an
# HMAC-signed request to the MAIN app (equipment.farmsky.africa), which
# owns the single merchant shortcode and executes the real transaction.
#
# Set these THREE variables on Render for live payments. You may use
# either the canonical FARMSKY_PAYMENTS_* names OR the short aliases
# (PAYMENT_*) — the server reads both.
#
#   1) Gateway URL — the MAIN app's payments API. You may set either the
#      full API path OR just the origin; the client normalizes it and
#      auto-appends /api/v1/payments when missing.
FARMSKY_PAYMENTS_GATEWAY_URL=https://equipment.farmsky.africa/api/v1/payments
#   (alias) PAYMENT_GATEWAY_URL=https://equipment.farmsky.africa/api/v1/payments
#
#   2) Client key — identifies this app to the gateway. MUST be exactly
#      "feed" (matches the app_clients row on the MAIN app). Defaults to
#      "feed" if left blank.
FARMSKY_PAYMENTS_CLIENT_KEY=feed
#   (alias) PAYMENT_CLIENT_KEY=feed
#
#   3) HMAC secret — MUST be byte-for-byte identical to the secret stored
#      in the MAIN app's app_clients.hmac_secret row for client_key='feed'.
#      Generate/rotate with: openssl rand -hex 32
FARMSKY_PAYMENTS_HMAC_SECRET=
#   (alias) PAYMENT_HMAC_SECRET=
# =====================================================================

# ----- M-Pesa Daraja — SATELLITE: leave blank (handled by the gateway) -----
# Only used by the direct-STK FALLBACK path for local/standalone dev.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=

# ----- SasaPay — SATELLITE: leave blank (handled by the gateway) -----
SASAPAY_CLIENT_ID=
SASAPAY_CLIENT_SECRET=
SASAPAY_MERCHANT_CODE=
SASAPAY_ENV=sandbox
SASAPAY_CALLBACK_URL=

# ----- KCB Buni — SATELLITE: leave blank (handled by the gateway) -----
KCB_CONSUMER_KEY=
KCB_CONSUMER_SECRET=
KCB_TILL_NUMBER=
KCB_ENV=sandbox
KCB_CALLBACK_URL=

# ----- SMS OTP provider (TalkSASA by default) -----
SMS_PROVIDER=
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=
SMS_BODY_TEMPLATE=
SMS_PHONE_FIELD=
SMS_MESSAGE_FIELD=

# ----- Email provider (export sharing — Resend by default) -----
EMAIL_PROVIDER=
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=

# =====================================================================
# CROSS-APP SSO + SHARED-DB ALIGNMENT (Feed <-> Equipment payment hub)
# ---------------------------------------------------------------------
# These make the Feed app communicate seamlessly with the Equipment app,
# which is the CENTRAL PLATFORM and the CENTRAL PAYMENT PROCESSING HUB
# (it processes payments from all other apps). Keep payment credentials
# on Equipment only — Feed forwards HMAC-signed requests to the gateway
# (see the CENTRAL PAYMENT GATEWAY block above).
# =====================================================================

# ----- App identity -----
# 'feed' for this app. Drives data-scope + payment-host context.
APP_TYPE=feed
# This app's own public origin (used to build hosted checkout URLs).
PUBLIC_BASE_URL=https://feed.farmsky.africa

# ----- Cross-app SSO handoff ("Shop Equipment" without re-login) -----
# CROSS_APP_URL   = the Equipment app origin (the SSO target).
# CROSS_APP_HMAC_SECRET = shared secret used to sign/verify the 2-min
#   handoff token. MUST be byte-for-byte identical on BOTH apps.
#   Generate/rotate with: openssl rand -hex 32
CROSS_APP_URL=https://equipment.farmsky.africa
CROSS_APP_HMAC_SECRET=

# ----- Farmsky Score cross-app SSO (optional) -----
# Origin of the Farmsky Score platform for the identity / credit-scoring
# hand-off. When this is set (together with CROSS_APP_HMAC_SECRET) an
# "Open Score" button appears in the top bar for super_admin / admin / lender
# users, opening Score with the SAME session (no second login). Leave blank if
# Score is not wired for this deployment (the button then stays hidden).
SCORE_APP_URL=

# ----- Standardized auth hashing (MUST MATCH the Equipment app) -----
# PBKDF2-SHA256. These three MUST be identical across Feed + Equipment so
# a password hashed on one app verifies on the other (single shared users
# table on the central DB). AUTH_PEPPER is a server-side secret pepper.
AUTH_HASH_ITERATIONS=210000
AUTH_HASH_KEYLEN=32
AUTH_PEPPER=

# =====================================================================
# SHARED CENTRAL DATABASE (Feed + Equipment + Score on ONE Postgres DB)
# ---------------------------------------------------------------------
# When Feed runs against the SAME central Postgres DB as Equipment/Score,
# the `users` table may be UUID-keyed (created by a sibling app) and carry
# an org_id UUID NOT NULL column. Feed's migrations converge the schema
# automatically; these vars control multi-tenant placement + isolation.
# On a STANDALONE Feed DB (own database) leave them blank.
# =====================================================================

# Optional: pin Feed to its own Postgres schema on a shared DB (defence
# in depth). Unset = the public schema.
DB_SCHEMA=

# Default tenant (org_id UUID) for user rows created OUTSIDE an admin
# session (public self-signup, bulk import) when users.org_id is NOT NULL.
# If unset, Feed auto-resolves the most-populated existing org, else the
# oldest organizations row. EQUIPMENT_ORG_ID is preferred; DEFAULT_ORG_ID
# is an accepted alias.
EQUIPMENT_ORG_ID=
DEFAULT_ORG_ID=

# =====================================================================
# AUTOMATED BACKUPS (every 6h) + external cron trigger
# ---------------------------------------------------------------------
# On the persistent Node server Feed self-triggers a JSON snapshot backup
# every 6 hours and (optionally) emails it. On Cloudflare/Workers there is
# no long-lived process, so drive it via an external cron hitting
# POST /api/backups/run-auto with the x-admin-task-token header.
# =====================================================================
BACKUP_EMAIL_TO=
BACKUP_NOTIFY_EMAIL=
ADMIN_TASK_TOKEN=

# ----- Session signing secret (REQUIRED in production) -----
# Fail-closed if unset in production. Generate with: openssl rand -hex 32
SESSION_SECRET=
